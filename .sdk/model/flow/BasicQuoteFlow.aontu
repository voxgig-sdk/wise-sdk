# BasicQuoteFlow

main: kit: flow: BasicQuoteFlow:
{
  entity: "quote",
  kind: "basic",
  name: "BasicQuoteFlow",
  step: [
    {
      i: {
        ref: "quote_ref01"
      }

      m: {
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      d: {
        profile_id: "profile01"
      }

      i: {
        ref: "quote_ref01",
        srcdatavar: "quote_ref01_data",
        suffix: "_up0",
        textfield: "createdTime"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-quote_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "quote_ref01",
        srcdatavar: "quote_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "quote01",
        profile_id: "profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-quote_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicQuoteFlow"
}