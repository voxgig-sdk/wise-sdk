# BasicBalanceFlow

main: kit: flow: BasicBalanceFlow:
{
  entity: "balance",
  kind: "basic",
  name: "BasicBalanceFlow",
  step: [
    {
      i: {
        ref: "balance_ref01"
      }

      m: {
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      m: {
        profile_id: "profile01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "balance_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "balance_ref01",
        srcdatavar: "balance_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "balance01",
        profile_id: "profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-balance_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "balance_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "balance01",
        profile_id: "profile01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        profile_id: "profile01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "balance_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBalanceFlow"
}