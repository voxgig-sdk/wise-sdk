# BasicCardOrderFlow

main: kit: flow: BasicCardOrderFlow:
{
  entity: "card_order",
  kind: "basic",
  name: "BasicCardOrderFlow",
  step: [
    {
      i: {
        ref: "card_order_ref01"
      }

      m: {
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      m: {
        profile_id: "profile01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "card_order_ref01"
          }
        }
      ]
    }

    {
      d: {
        profile_id: "profile01"
      }

      i: {
        ref: "card_order_ref01",
        srcdatavar: "card_order_ref01_data",
        suffix: "_up0",
        textfield: "cardHolderName"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-card_order_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "card_order_ref01",
        srcdatavar: "card_order_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "card_order01",
        profile_id: "profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-card_order_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCardOrderFlow"
}