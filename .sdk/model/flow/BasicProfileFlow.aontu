# BasicProfileFlow

main: kit: flow: BasicProfileFlow:
{
  entity: "profile",
  kind: "basic",
  name: "BasicProfileFlow",
  step: [
    {
      i: {
        ref: "profile_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "profile_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "profile_ref01",
        srcdatavar: "profile_ref01_data",
        suffix: "_up0",
        textfield: "avatar"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-profile_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "profile_ref01",
        srcdatavar: "profile_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-profile_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "profile_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "profile01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "profile_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProfileFlow"
}