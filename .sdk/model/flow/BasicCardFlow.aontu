# BasicCardFlow

main: kit: flow: BasicCardFlow:
{
  entity: "card",
  kind: "basic",
  name: "BasicCardFlow",
  step: [
    {
      i: {
        ref: "card_ref01"
      }

      m: {
        card_token: "card_token01",
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      m: {
        profile_id: "profile01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "card_ref01"
          }
        }
      ]
    }

    {
      d: {
        profile_id: "profile01"
      }

      i: {
        ref: "card_ref01",
        srcdatavar: "card_ref01_data",
        suffix: "_up0",
        textfield: "bankIdentificationNumber"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-card_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "card_ref01",
        srcdatavar: "card_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "card01",
        profile_id: "profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-card_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCardFlow"
}