# BasicLinkRequestFlow

main: kit: flow: BasicLinkRequestFlow:
{
  entity: "link_request",
  kind: "basic",
  name: "BasicLinkRequestFlow",
  step: [
    {
      i: {
        ref: "link_request_ref01"
      }

      m: {
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      i: {
        ref: "link_request_ref01",
        srcdatavar: "link_request_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "link_request01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-link_request_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLinkRequestFlow"
}