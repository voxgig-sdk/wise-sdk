# BasicBatchGroupFlow

main: kit: flow: BasicBatchGroupFlow:
{
  entity: "batch_group",
  kind: "basic",
  name: "BasicBatchGroupFlow",
  step: [
    {
      i: {
        ref: "batch_group_ref01"
      }

      m: {
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      d: {
        profile_id: "profile01"
      }

      i: {
        ref: "batch_group_ref01",
        srcdatavar: "batch_group_ref01_data",
        suffix: "_up0",
        textfield: "fileName"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-batch_group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "batch_group_ref01",
        srcdatavar: "batch_group_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "batch_group01",
        profile_id: "profile01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-batch_group_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBatchGroupFlow"
}