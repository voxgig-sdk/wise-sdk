# BasicVerificationFlow

main: kit: flow: BasicVerificationFlow:
{
  entity: "verification",
  kind: "basic",
  name: "BasicVerificationFlow",
  step: [
    {
      i: {
        ref: "verification_ref01"
      }

      m: {
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      m: {
        profile_id: "profile01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "verification_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVerificationFlow"
}