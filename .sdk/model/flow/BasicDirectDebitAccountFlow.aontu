  name: "BasicDirectDebitAccountFlow",
  step: [
    {
      i: {
        ref: "direct_debit_account_ref01"
      }

      m: {
        profile_id: "profile01"
      }

      o: "create"
    }

    {
      m: {
        profile_id: "profile01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "direct_debit_account_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDirectDebitAccountFlow"
}