# Project overlay — YOURS. The scaffold creates this file once and never
# overwrites it.
#
# Most of model/ is toolchain-derived and is deliberately regenerated so that
# toolchain fixes propagate; this file, the guide, and the target, feature and
# edition indexes are kept. Put anything here that is a decision about THIS
# project rather than a fact about the API.
#
# Included LAST by sdk.aontu, after target/target-index.aontu, because a key
# under main.kit.target.<t> can only refine a target that has already been
# defined. Declared earlier, the model build fails with "Cannot unify value:
# nil with value: string / key ext value was: nil", which names nothing that
# would lead you here.
#
# The release version each generated manifest declares (package.json,
# pyproject.toml, the gemspec, the rockspec) and that the port Makefiles tag:
#
#   main: kit: target: ts: publish: version: '1.2.3'
#
# Per target, because ports publish to different registries on different
# clocks. Set every target to the same value for a lockstep repo.
#
# A published package name that does not follow the derivation:
#
#   main: kit: target: ts: publish: registry: package: '@scope/name'
#
# How an add, or a re-scaffold, treats a file in .sdk the project changed:
# merged with the update (the default), or overwritten, for a project
# regenerated in full from the toolchain:
#
#   main: kit: copies: 'overwrite'
# NO MCP SERVER (Richard, 2026-11-10: "remove mcp, as a customization in
# project.aontu"). Wise already runs its own hosted MCP server
# (mcp.wise.com/mcp, read-only, with Wise-hosted OAuth) and a docs MCP, and
# this API moves money. The go-mcp target stays in admin data/cedar.csv, so
# every regen still adds it and the model still defines it; switching it off
# here stops it being generated (RootPlan skips an inactive target) and drops
# the MCP server from the README and the docs.
main: kit: target: 'go-mcp': active: false

# outreach1 standard (2026-11-10): std8 targets, less go-mcp above, the
# standard features (including secrets) and a branded GitHub Pages
# documentation site.
main: kit: doc: edition: 'github-pages': active: true
# GitHub Pages will be enabled for this repository when it is published, so
# generated documentation may link the site.
main: kit: doc: edition: 'github-pages': published: true
# Brand palette, taken from wise.com's own stylesheet tokens: forest green
# --color-forest-green #163300 is the primary, bright green
# --color-bright-green #9fe870 the accent (docgen uses the accent only for
# tints and gradients, never for text). Body text #0e0f0c on white. Light
# only: docgen keeps the primary in dark mode, and forest green on a dark page
# would not be readable.
main: kit: doc: style: mode: 'light'
main: kit: doc: style: color: {
  primary: '#163300'
  accent: '#9fe870'
  background: '#ffffff'
  text: '#0e0f0c'
  darkBackground: '#121511'
  darkText: '#ffffff'
}
# Published package names, declared so a change in the generator's naming
# rule cannot rename a released package.
main: kit: target: ts: publish: registry: package: '@voxgig-sdk/wise-sdk'
main: kit: target: py: publish: registry: package: 'voxgig-sdk-wise-sdk'
main: kit: target: lua: publish: registry: package: 'voxgig-sdk-wise-sdk'
main: kit: target: php: publish: registry: package: 'voxgig-sdk/wise-sdk'
main: kit: target: rb: publish: registry: package: 'voxgig-sdk-wise-sdk'
# --- cedar: copies (written by cedar-regen.sh, do not hand-edit)
# Regenerated in full: not listed in admin data/customized.csv.
main: kit: copies: 'overwrite'
# --- end cedar: copies
# --- cedar: secrets active (written by cedar-regen.sh, do not hand-edit)
main: kit: feature: secrets: active: true
# --- end cedar: secrets active
